From 97a7f0fc927d28e3f35b5fc1af580f28615ddccf Mon Sep 17 00:00:00 2001
From: zhangwanhao <zhangwanhao1@huaiwei.com>
Date: Mon, 26 Oct 2026 18:55:48 +0800
Subject: [PATCH] feat: wire explicit balanced backend options through the
 ordinary expert FSDP path

---
 .../distributed/expert_parallel/expert_parallel.py    |  8 ++++++--
 .../fsdp2/distributed/parallel_engine_config.py       |  3 ++-
 mindspeed_llm/fsdp2/models/model_factory.py           |  9 +++++++++
 mindspeed_llm/fsdp2/utils/arguments.py                | 11 +++++++++--
 4 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/mindspeed_llm/fsdp2/distributed/expert_parallel/expert_parallel.py b/mindspeed_llm/fsdp2/distributed/expert_parallel/expert_parallel.py
index cdaa6e6d..d5d311c0 100644
--- a/mindspeed_llm/fsdp2/distributed/expert_parallel/expert_parallel.py
+++ b/mindspeed_llm/fsdp2/distributed/expert_parallel/expert_parallel.py
@@ -58,7 +58,8 @@ def apply_common_experts_forward(module: torch.nn.Module, ep_mesh: DeviceMesh, p
     distribute_experts_module(module, ep_mesh)
 
     # replace forward with ep forward
-    experts_forward_fn = get_dispatcher_fn(plan.dispatcher, ep_group, fixed_router=plan.fixed_router)
+    experts_forward_fn = get_dispatcher_fn(plan.dispatcher, ep_group, fixed_router=plan.fixed_router,
+        balanced_config=getattr(plan, 'megamoe_balanced_config', None))
     module.forward = types.MethodType(experts_forward_fn, module)
 
 
@@ -121,7 +122,7 @@ def distribute_experts_module(module: torch.nn.Module, ep_mesh: DeviceMesh):
     # input_fn=prepare_distribute_input_fn, output_fn=prepare_distribute_output_fn)
 
 
-def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False):
+def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False, balanced_config=None):
     forward_fn = None
     if isinstance(dispatcher, Callable):
         forward_fn = partial(dispatcher, ep_group)
@@ -132,6 +133,9 @@ def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False):
             forward_fn = get_experts_forward_fn(ep_group, fused=True, fixed_router=fixed_router)
         elif dispatcher == 'mc2':
             forward_fn = get_experts_forward_mc2_fn(ep_group, fixed_router=fixed_router)
+        elif dispatcher == 'megamoe_balanced':
+            from fsdp_turbo.distributed.expert_parallel.dispatcher_megamoe_balanced import get_megamoe_balanced_forward_fn
+            forward_fn = get_megamoe_balanced_forward_fn(ep_group, fixed_router, balanced_config)
         elif dispatcher == 'mega_moe':
             # Lazy import: mega_moe is an optional dispatcher that requires FSDPTurbo
             # to contain dispatcher_mega_moe.py (feat/megamoe-fsdp branch). Keep the
diff --git a/mindspeed_llm/fsdp2/distributed/parallel_engine_config.py b/mindspeed_llm/fsdp2/distributed/parallel_engine_config.py
index a77d9702..346177c0 100644
--- a/mindspeed_llm/fsdp2/distributed/parallel_engine_config.py
+++ b/mindspeed_llm/fsdp2/distributed/parallel_engine_config.py
@@ -33,11 +33,12 @@ class CPPlanConfig:
 @dataclass
 class EPPlanConfig:
     apply_modules: List[str] = None
-    dispatcher: Union[Literal["eager", "fused", "mc2", "mega_moe", "moonep", "moonep_megamoe"], Callable] = None
+    dispatcher: Union[Literal["eager", "fused", "mc2", "mega_moe", "moonep", "moonep_megamoe", "megamoe_balanced"], Callable] = None
     apply_efsdp_modules: List[str] = None
     gradient_divide_factor: Optional[float] = None
     fixed_router: bool = False
     moonep_config: Optional[object] = None
+    megamoe_balanced_config: Optional[object] = None
 
 
 @dataclass
diff --git a/mindspeed_llm/fsdp2/models/model_factory.py b/mindspeed_llm/fsdp2/models/model_factory.py
index 8dccb0ee..c5d620dc 100644
--- a/mindspeed_llm/fsdp2/models/model_factory.py
+++ b/mindspeed_llm/fsdp2/models/model_factory.py
@@ -251,12 +251,21 @@ class ModelFactory:
                 # it unset and use the UID-broadcast path (no TCP bootstrap).
                 shmem_ip_port=os.environ.get("MOONEP_SHMEM_IP_PORT"),
             )
+        balanced_cfg = None
+        if parallel_args.ep_dispatcher == "megamoe_balanced":
+            from fsdp_turbo.fsdp_turbo_config import MegaMoeBalancedConfig
+            balanced_cfg = MegaMoeBalancedConfig(
+                planner=args.megamoe_balanced_planner,
+                replica_slots=args.megamoe_balanced_replica_slots,
+                backward_restore=args.megamoe_balanced_backward_restore,
+            )
         ep_plan = EPPlanConfig(
             apply_modules=parallel_args.ep_modules,
             apply_efsdp_modules=parallel_args.ep_fsdp_modules,
             dispatcher=parallel_args.ep_dispatcher,
             fixed_router=args.fix_router,
             moonep_config=moon_cfg,
+            megamoe_balanced_config=balanced_cfg,
         )
 
         cp_plan = CPPlanConfig(context_parallel_type=parallel_args.cp_type, is_pack=getattr(model_args, "pack", False))
diff --git a/mindspeed_llm/fsdp2/utils/arguments.py b/mindspeed_llm/fsdp2/utils/arguments.py
index 0c19c7c9..85df7a5d 100644
--- a/mindspeed_llm/fsdp2/utils/arguments.py
+++ b/mindspeed_llm/fsdp2/utils/arguments.py
@@ -456,7 +456,7 @@ class ParallelArguments:
         default_factory=lambda: ['model.layers.{*}.mlp.experts'],
         metadata={"help": "Model structure of layers with FSDP inside Expert Parallel groups."},
     )
-    ep_dispatcher: Literal["eager", "fused", "mc2", "mega_moe", "moonep", "moonep_megamoe"] = field(
+    ep_dispatcher: Literal["eager", "fused", "mc2", "mega_moe", "moonep", "moonep_megamoe", "megamoe_balanced"] = field(
         default="eager",
         metadata={
             "help": "Dispatcher strategy for Expert Parallel (MoE). "
@@ -465,7 +465,8 @@ class ParallelArguments:
             "'mc2' (mixed compression dispatch to reduce cross-card communication cost), "
             "'mega_moe' (fused MegaMoe BF16 dispatch+GMM+SwiGLU over CANN SHMEM), "
             "'moonep' (symmetric-memory redundant experts), "
-            "'moonep_megamoe' (MoonEP redundant-expert weights with MegaMoe fused compute). "
+            "'moonep_megamoe' (MoonEP redundant-expert weights with MegaMoe fused compute), "
+            "'megamoe_balanced' (optional Native/MoonEP planner with S9 executor). "
             "Defaults to 'eager'."
         },
     )
@@ -867,6 +868,12 @@ class OptimizationArguments:
             ">0 uses a few hotspot experts, not linspace)."
         },
     )
+    megamoe_balanced_planner: Literal["native", "moonep"] = field(
+        default="moonep", metadata={"help": "Planner policy for megamoe_balanced only."})
+    megamoe_balanced_replica_slots: Optional[int] = field(
+        default=None, metadata={"help": "Replica slots per rank; default E/EP. MoonEP requires E/EP."})
+    megamoe_balanced_backward_restore: Literal["staged", "expert", "panel"] = field(
+        default="staged", metadata={"help": "Backward replica restoration mode for megamoe_balanced."})
     router_imbalance: float = field(
         default=0.0,
         metadata={
-- 

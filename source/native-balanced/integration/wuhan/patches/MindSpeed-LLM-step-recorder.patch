Subject: [PATCH 2/3] test: fingerprint initial training shards and close step
 records

---
 mindspeed_llm/fsdp2/train/step_record.py | 20 ++++++++++++++++++++
 mindspeed_llm/fsdp2/train/trainer.py     |  4 ++++
 2 files changed, 24 insertions(+)

diff --git a/mindspeed_llm/fsdp2/train/step_record.py b/mindspeed_llm/fsdp2/train/step_record.py
index 1f88edbb..9bad3721 100644
--- a/mindspeed_llm/fsdp2/train/step_record.py
+++ b/mindspeed_llm/fsdp2/train/step_record.py
@@ -3,6 +3,7 @@
 No per-layer synchronization. Each boundary waits for the current device;
 JSON serialization, log aggregation and file writes are outside the interval.
 """
+import hashlib
 import json
 import math
 import os
@@ -32,6 +33,22 @@ class StepRecorder:
         torch.accelerator.synchronize()
         self.started = time.perf_counter_ns()
 
+    def snapshot_parameters(self, model):
+        """Hash actual local shards once, before any measured step; no RNG use."""
+        rows = []
+        for name, parameter in model.named_parameters():
+            local = parameter.to_local() if hasattr(parameter, 'to_local') else parameter
+            flat = local.detach().contiguous().reshape(-1)
+            sha = hashlib.sha256()
+            chunk = max(1, 16 * 1024**2 // flat.element_size())
+            for start in range(0, flat.numel(), chunk):
+                sha.update(flat[start:start + chunk].cpu().view(torch.uint8).numpy().tobytes())
+            rows.append(dict(name=name, shape=list(parameter.shape), local_shape=list(local.shape),
+                             dtype=str(local.dtype), sha256=sha.hexdigest()))
+        path = self.directory / f'initial-rank{dist.get_rank()}.json'
+        with path.open('x') as handle:
+            json.dump(dict(rank=dist.get_rank(), parameters=rows), handle, indent=2)
+
     def stop(self, step, losses, grad_norm):
         torch.accelerator.synchronize()
         stopped = time.perf_counter_ns()
@@ -51,3 +68,6 @@ class StepRecorder:
 
     def write(self, row):
         self.file.write(json.dumps(row, allow_nan=False) + '\n')
+
+    def close(self):
+        self.file.close()

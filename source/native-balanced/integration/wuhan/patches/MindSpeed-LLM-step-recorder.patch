@@ -0,0 +1,53 @@
+"""Opt-in complete-step wall records for paired Wuhan backend experiments.
+
+No per-layer synchronization. Each boundary waits for the current device;
+JSON serialization, log aggregation and file writes are outside the interval.
+"""
+import json
+import math
+import os
+from pathlib import Path
+import time
+
+import torch
+import torch.distributed as dist
+
+
+class StepRecorder:
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True)
+        self.path = self.directory / f'rank{dist.get_rank()}.jsonl'
+        self.file = self.path.open('x', buffering=1)
+        self.started = None
+
+    @classmethod
+    def from_environment(cls):
+        directory = os.environ.get('WUHAN_STEP_RECORD_DIR', '')
+        return cls(directory) if directory else None
+
+    def start(self):
+        if self.started is not None:
+            raise RuntimeError('overlapping complete-step measurement')
+        torch.accelerator.synchronize()
+        self.started = time.perf_counter_ns()
+
+    def stop(self, step, losses, grad_norm):
+        torch.accelerator.synchronize()
+        stopped = time.perf_counter_ns()
+        if self.started is None:
+            raise RuntimeError('missing complete-step measurement start')
+        elapsed = (stopped - self.started) / 1e6
+        self.started = None
+        values = [float(v) for v in losses]
+        norm = float(grad_norm)
+        if not all(math.isfinite(v) for v in [*values, norm]):
+            raise FloatingPointError('nonfinite loss/gradient in paired training acceptance')
+        return dict(step=int(step), rank=dist.get_rank(), wall_ms=elapsed,
+                    loss=values[0], lm_loss=values[1], mtp_loss=values[2], aux_loss=values[3],
+                    grad_norm=norm, allocated_bytes=torch.npu.memory_allocated(),
+                    reserved_bytes=torch.npu.memory_reserved(),
+                    boundary='before_fetch_to_optimizer_zero_grad_device_complete')
+
+    def write(self, row):
+        self.file.write(json.dumps(row, allow_nan=False) + '\n')

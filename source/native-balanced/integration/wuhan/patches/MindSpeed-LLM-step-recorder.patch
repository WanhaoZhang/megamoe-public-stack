From 08f2e5c2d67a095f482a5546b01022c4a74c46aa Mon Sep 17 00:00:00 2001
From: zhangwanhao <zhangwanhao1@huaiwei.com>
Date: Mon, 26 Oct 2026 20:48:43 +0800
Subject: [PATCH 3/3] feat: record reduced losses and actual training batch
 identity outside timing

---
 mindspeed_llm/fsdp2/train/step_record.py | 35 ++++++++++++++++++++++++
 mindspeed_llm/fsdp2/train/trainer.py     |  7 +++++
 2 files changed, 42 insertions(+)

diff --git a/mindspeed_llm/fsdp2/train/step_record.py b/mindspeed_llm/fsdp2/train/step_record.py
index 9bad3721..03c41209 100644
--- a/mindspeed_llm/fsdp2/train/step_record.py
+++ b/mindspeed_llm/fsdp2/train/step_record.py
@@ -69,5 +69,40 @@ class StepRecorder:
     def write(self, row):
         self.file.write(json.dumps(row, allow_nan=False) + '\n')
 
+    @staticmethod
+    def hold_batch(value):
+        # _compute_loss replaces inputs['labels'] with None in PT. Retain the
+        # fetched tensor references in a separate container before that edit;
+        # no payload copy, device work or random-number use is introduced.
+        if isinstance(value, dict):
+            return {key: StepRecorder.hold_batch(item) for key, item in value.items()}
+        if isinstance(value, (tuple, list)):
+            return [StepRecorder.hold_batch(item) for item in value]
+        return value
+
+    def fingerprint_batch(self, batches):
+        """Actual fetched data identity; call only after the timed interval."""
+        if self.started is not None:
+            raise RuntimeError('batch fingerprint must be outside step timing')
+        rows = []
+        def visit(value, path):
+            if isinstance(value, torch.Tensor):
+                local = value.to_local() if hasattr(value, 'to_local') else value
+                payload = local.detach().contiguous().cpu().reshape(-1).view(torch.uint8).numpy().tobytes()
+                rows.append(dict(path=path, shape=list(local.shape), dtype=str(local.dtype),
+                                 sha256=hashlib.sha256(payload).hexdigest()))
+            elif isinstance(value, dict):
+                for key in sorted(value):
+                    visit(value[key], f'{path}/{key}')
+            elif isinstance(value, (tuple, list)):
+                for index, item in enumerate(value):
+                    visit(item, f'{path}/{index}')
+            elif isinstance(value, (str, int, float, bool)):
+                rows.append(dict(path=path, scalar=value))
+            elif value is not None:
+                raise TypeError(f'unhandled batch identity type at {path}: {type(value)}')
+        visit(batches, 'batches')
+        return rows
+
     def close(self):
         self.file.close()
diff --git a/mindspeed_llm/fsdp2/train/trainer.py b/mindspeed_llm/fsdp2/train/trainer.py
index 5ed6b4f1..d7696248 100644
--- a/mindspeed_llm/fsdp2/train/trainer.py
+++ b/mindspeed_llm/fsdp2/train/trainer.py
@@ -377,6 +377,7 @@ class Trainer:
                 batch_samples, batch_seqlens, num_items_in_batch = self.get_batch_samples_func()(
                     ps, epoch_iterator, num_batches
                 )
+                paired_batch = paired_step_recorder.hold_batch(batch_samples) if paired_step_recorder is not None else None
                 self.current_gradient_accumulation_steps = len(batch_samples)
                 # Initialize accumulated loss for the current step
                 current_step_loss = 0.0
@@ -492,6 +493,12 @@ class Trainer:
 
                 self._total_loss_scalar += reduced_loss
                 if paired_step_recorder is not None:
+                    paired_step_row['reduced_losses'] = dict(
+                        loss=float(reduced_loss), lm_loss=float(reduced_lm_loss),
+                        mtp_loss=float(reduced_mtp_loss), aux_loss=float(reduced_aux_loss),
+                        grad_norm=float(reduced_grad_norm))
+                    paired_step_row['batch_fingerprints'] = paired_step_recorder.fingerprint_batch(paired_batch)
+                    del paired_batch
                     paired_step_recorder.write(paired_step_row)
                 self._total_lm_loss_scalar += reduced_lm_loss
                 self._total_mtp_loss_scalar += reduced_mtp_loss

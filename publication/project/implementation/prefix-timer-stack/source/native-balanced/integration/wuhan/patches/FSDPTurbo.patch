From e65b97bc69c193dc65afa11c8f85039c9f1ddbee Mon Sep 17 00:00:00 2001
From: zhangwanhao <zhangwanhao1@huaiwei.com>
Date: Mon, 26 Oct 2026 18:55:48 +0800
Subject: [PATCH] feat: add isolated megamoe balanced dispatcher and planner
 configuration

---
 .../dispatcher_megamoe_balanced.py            | 86 +++++++++++++++++++
 .../expert_parallel/expert_parallel.py        |  8 +-
 fsdp_turbo/fsdp_turbo_config.py               | 18 +++-
 3 files changed, 109 insertions(+), 3 deletions(-)
 create mode 100644 fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py

diff --git a/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py b/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py
new file mode 100644
index 0000000..e27a960
--- /dev/null
+++ b/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py
@@ -0,0 +1,86 @@
+"""S9 feature dispatcher. Ordinary FSDP owns Parameters and its reductions.
+
+The author MoonEP runtime is deliberately not initialized by this dispatcher.
+Both planner policies use one ascend_deepep runtime and the same executor SO.
+"""
+import threading
+
+import torch
+from torch.distributed.tensor import DTensor
+
+from .dispatcher_mega_moe import _ensure_mega_moe_runtime, _local_mem_bytes
+from .utils import fixed_router_for_debug, normalize_expert_args
+
+
+_POOLS = {}
+_LOCK = threading.Lock()
+
+
+def _local(weight):
+    return weight.to_local() if isinstance(weight, DTensor) else weight
+
+
+def get_megamoe_balanced_forward_fn(ep_group, fixed_router=False, config=None):
+    from fsdp_turbo.fsdp_turbo_config import MegaMoeBalancedConfig
+    config = config or MegaMoeBalancedConfig()
+
+    def balanced_forward(self, hidden_states, top_k_index, top_k_weights):
+        from ascend_deepep.fsdp2_bridge import FSDP2ExpertsBridge, NativeFSDP2Pool
+        ids, prob = normalize_expert_args(top_k_index, top_k_weights)
+        ep = torch.distributed.get_world_size(ep_group)
+        if ep not in (2, 4, 8):
+            raise ValueError('megamoe_balanced currently accepts EP2/4/8 only')
+        if ids.ndim == 1:
+            ids, prob = ids.unsqueeze(-1), prob.unsqueeze(-1)
+        if fixed_router:
+            ids, prob = fixed_router_for_debug(ids, prob, self.num_global_experts, ep_size=ep)
+        shape = hidden_states.shape
+        hidden = int(self.hidden_dim)
+        x = hidden_states.reshape(-1, hidden).contiguous()
+        if x.dtype != torch.bfloat16:
+            raise ValueError('megamoe_balanced expects BF16 expert activations')
+        ids = ids.reshape(x.shape[0], -1).to(torch.int32).contiguous()
+        prob = prob.reshape_as(ids).contiguous()
+        tokens, topk = ids.shape
+        # Read attributes every invocation, after FSDP unshard. Never capture
+        # a pre-wrap Parameter or a pooled replica pointer in this closure.
+        weights = lambda: (_local(self.gate_up_proj), _local(self.down_proj))
+        w1, w2 = weights()
+        home, out, actual_hidden = w1.shape
+        ffn = out // 2
+        if actual_hidden != hidden or tuple(w2.shape) != (home, hidden, ffn):
+            raise ValueError('unsupported expert Parameter layout')
+        slots = home if config.replica_slots is None else int(config.replica_slots)
+        if config.planner == 'moonep' and slots != home:
+            raise ValueError('MoonEP balanced planner requires replica_slots=home')
+        capacity = tokens * topk if config.planner == 'moonep' else tokens * topk * ep
+        capacity = (capacity + 127) // 128 * 128
+        window = _local_mem_bytes(tokens, hidden, topk, ep, home + slots, capacity)
+        # Split S9 storage: homes + replicas + BF16 replica partials; include
+        # generous control/ready padding. This is one pool, not per-layer HBM.
+        replica_storage = (home + 2*slots) * 3*ffn*hidden*2 + 32*1024*1024
+        key = (id(ep_group), home, slots, hidden, ffn, tokens, topk,
+               config.planner, config.backward_restore, capacity)
+        with _LOCK:
+            pool = _POOLS.get(key)
+            if pool is None:
+                if _POOLS:
+                    raise RuntimeError('balanced integration requires one static expert shape per process')
+                shmem = _ensure_mega_moe_runtime(ep_group, window_pool_size=1,
+                                                window_bytes=window + replica_storage)
+                pool = NativeFSDP2Pool(shmem, ep_group, home, slots, hidden, ffn,
+                    tokens, topk, window, capacity, x.device, config.planner, config.backward_restore)
+                _POOLS[key] = pool
+                print(f'[MegaMoeBalanced] planner={config.planner} slots={slots} '
+                      f'restore={config.backward_restore} home={home} shape={tokens,hidden,ffn,topk} '
+                      f'max_recv={capacity} worker_flags=0 owner_rows=16', flush=True)
+        bridge = getattr(self, '_megamoe_balanced_bridge', None)
+        if bridge is None:
+            bridge = FSDP2ExpertsBridge(pool, weights)
+            self._megamoe_balanced_bridge = bridge
+        elif bridge.pool is not pool:
+            raise RuntimeError('expert module changed its balanced execution configuration')
+        limit = getattr(self, 'limit', 0.)
+        return bridge(x, ids, prob, 0. if limit is None else float(limit)).view(shape)
+
+    return balanced_forward
diff --git a/fsdp_turbo/distributed/expert_parallel/expert_parallel.py b/fsdp_turbo/distributed/expert_parallel/expert_parallel.py
index 40a9bdd..478ef8c 100644
--- a/fsdp_turbo/distributed/expert_parallel/expert_parallel.py
+++ b/fsdp_turbo/distributed/expert_parallel/expert_parallel.py
@@ -94,7 +94,8 @@ def expert_parallelize_modules(
 
         # Select the complete EP forward explicitly through the dispatcher plan.
         experts_forward_fn = get_dispatcher_fn(plan.dispatcher, ep_group, fixed_router=plan.fixed_router,
-                                              megamoe_precision=getattr(plan, "megamoe_precision", "bf16"))
+                                              megamoe_precision=getattr(plan, "megamoe_precision", "bf16"),
+                                              balanced_config=getattr(plan, "megamoe_balanced_config", None))
         module.forward = types.MethodType(experts_forward_fn, module)
 
     if moonep_runtime is not None:
@@ -284,7 +285,7 @@ def distribute_experts_module(module: torch.nn.Module, ep_mesh: DeviceMesh):
     )
 
 
-def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False, megamoe_precision="bf16"):
+def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False, megamoe_precision="bf16", balanced_config=None):
     if megamoe_precision not in ("bf16", "mxfp8"):
         raise ValueError(f"Unsupported MegaMoE precision: {megamoe_precision}")
     if megamoe_precision != "bf16" and dispatcher != "mega_moe":
@@ -304,6 +305,9 @@ def get_dispatcher_fn(dispatcher, ep_group, fixed_router=False, megamoe_precisio
         elif dispatcher == 'mega_moe' and megamoe_precision == 'mxfp8':
             from fsdp_turbo.distributed.expert_parallel.dispatcher_mega_moe_mxfp8 import get_mega_moe_mxfp8_forward_fn
             forward_fn = get_mega_moe_mxfp8_forward_fn(ep_group, fixed_router=fixed_router)
+        elif dispatcher == 'megamoe_balanced':
+            from .dispatcher_megamoe_balanced import get_megamoe_balanced_forward_fn
+            forward_fn = get_megamoe_balanced_forward_fn(ep_group, fixed_router, balanced_config)
         elif dispatcher == 'mega_moe':
             forward_fn = get_mega_moe_forward_fn(ep_group, fixed_router=fixed_router)
         elif dispatcher.startswith('custom_'):
diff --git a/fsdp_turbo/fsdp_turbo_config.py b/fsdp_turbo/fsdp_turbo_config.py
index 72725cb..329b78a 100644
--- a/fsdp_turbo/fsdp_turbo_config.py
+++ b/fsdp_turbo/fsdp_turbo_config.py
@@ -219,10 +219,25 @@ class MoonEPConfig:
 MOONEP_RUNTIME_DISPATCHERS = ("moonep", "moonep_megamoe")
 
 
+@dataclass(frozen=True)
+class MegaMoeBalancedConfig:
+    planner: Literal["native", "moonep"] = "moonep"
+    replica_slots: Optional[int] = None
+    backward_restore: Literal["staged", "expert", "panel"] = "staged"
+
+    def __post_init__(self):
+        if self.planner not in ("native", "moonep"):
+            raise ValueError("unknown MegaMoE balanced planner")
+        if self.replica_slots is not None and self.replica_slots < 0:
+            raise ValueError("replica_slots must be nonnegative")
+        if self.backward_restore not in ("staged", "expert", "panel"):
+            raise ValueError("unknown backward restoration mode")
+
+
 @dataclass
 class EPPlanConfig:
     apply_modules: List[str] = None
-    dispatcher: Union[Literal["eager", "fused", "mc2", "domino", "mega_moe", "moonep", "moonep_megamoe"], Callable, str] = None
+    dispatcher: Union[Literal["eager", "fused", "mc2", "domino", "mega_moe", "moonep", "moonep_megamoe", "megamoe_balanced"], Callable, str] = None
     fixed_router: bool = False
     apply_efsdp_modules: List[str] = None
     moonep_config: Optional[MoonEPConfig] = None
@@ -230,6 +245,7 @@ class EPPlanConfig:
     # computed in the config validation as ep * edp * efsdp.
     gradient_divide_factor: Optional[float] = None
     megamoe_precision: Literal["bf16", "mxfp8"] = "bf16"
+    megamoe_balanced_config: Optional[MegaMoeBalancedConfig] = None
 
 
 @dataclass

From 187b5ff79057c8e848f58eae7e99a73608178147 Mon Sep 17 00:00:00 2001
From: zhangwanhao <zhangwanhao1@huaiwei.com>
Date: Tue, 27 Oct 2026 01:46:53 +0800
Subject: [PATCH] feat: allow explicit bounded receive capacity for balanced
 workloads

---
 .../expert_parallel/dispatcher_megamoe_balanced.py          | 6 ++++++
 fsdp_turbo/fsdp_turbo_config.py                             | 3 +++
 2 files changed, 9 insertions(+)

diff --git a/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py b/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py
index e27a960..dbcdef6 100644
--- a/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py
+++ b/fsdp_turbo/distributed/expert_parallel/dispatcher_megamoe_balanced.py
@@ -55,6 +55,12 @@ def get_megamoe_balanced_forward_fn(ep_group, fixed_router=False, config=None):
             raise ValueError('MoonEP balanced planner requires replica_slots=home')
         capacity = tokens * topk if config.planner == 'moonep' else tokens * topk * ep
         capacity = (capacity + 127) // 128 * 128
+        if config.recv_capacity is not None:
+            # Explicit bounded-workload allocation. Native collective plan
+            # validation still rejects routes that exceed this capacity.
+            capacity = int(config.recv_capacity)
+            if capacity < (tokens * topk + 127) // 128 * 128:
+                raise ValueError('recv_capacity is smaller than the EP average route load')
         window = _local_mem_bytes(tokens, hidden, topk, ep, home + slots, capacity)
         # Split S9 storage: homes + replicas + BF16 replica partials; include
         # generous control/ready padding. This is one pool, not per-layer HBM.
diff --git a/fsdp_turbo/fsdp_turbo_config.py b/fsdp_turbo/fsdp_turbo_config.py
index 329b78a..384a234 100644
--- a/fsdp_turbo/fsdp_turbo_config.py
+++ b/fsdp_turbo/fsdp_turbo_config.py
@@ -224,6 +224,7 @@ class MegaMoeBalancedConfig:
     planner: Literal["native", "moonep"] = "moonep"
     replica_slots: Optional[int] = None
     backward_restore: Literal["staged", "expert", "panel"] = "staged"
+    recv_capacity: Optional[int] = None
 
     def __post_init__(self):
         if self.planner not in ("native", "moonep"):
@@ -232,6 +233,8 @@ class MegaMoeBalancedConfig:
             raise ValueError("replica_slots must be nonnegative")
         if self.backward_restore not in ("staged", "expert", "panel"):
             raise ValueError("unknown backward restoration mode")
+        if self.recv_capacity is not None and (self.recv_capacity <= 0 or self.recv_capacity % 128):
+            raise ValueError("recv_capacity must be a positive multiple of 128")
 
 
 @dataclass
-- 
2.56.0.windows.1

